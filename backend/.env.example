# Server Configuration
PORT=5000
NODE_ENV=development

# Local PostgreSQL Database Configuration
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bonchi_db

# Local PostgREST URL (Standalone server running on port 3001)
POSTGREST_URL=http://localhost:3001

# Security & PostgREST Shared Secret (MUST be >= 32 characters)
JWT_SECRET=super_secret_bonchi_jwt_key_2026_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# S3 / Object Storage (Receipts)
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_BUCKET=bonchi-receipts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
