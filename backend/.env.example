# Server Port (Railway automatically sets PORT variable)
PORT=5000
NODE_ENV=production

# Database Connection (In Railway, use ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:1234@localhost:5432/bonhchi_db

# Security
JWT_SECRET=super_secret_bonchi_jwt_key_2026_at_least_32_characters_long
JWT_EXPIRES_IN=24h
